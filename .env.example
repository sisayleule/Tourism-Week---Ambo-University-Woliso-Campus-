# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env (never commit .env) and fill in the values from
# your Supabase project dashboard → Settings → API.
#
# SAFE for the frontend (anon key only — read-limited by RLS):
VITE_SUPABASE_URL="https://otdaiykbrmjycjwfjndt.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_uTprYv4rF9_xGzjn71GVuw_fCLrM-b_"
#
# NEVER put service_role key in any frontend file or commit it anywhere.
# Use it only inside Supabase Edge Functions or CI seed scripts,
# and pass it as a secret environment variable in those environments.



# ─── Phase 5: Publishing pipeline ────────────────────────────────────────────
# VITE_SITE_URL: The canonical public site URL (used for sitemap + SEO tags).
#               Set this to your Vercel deployment URL, e.g. https://your-app.vercel.app
VITE_SITE_URL=""

# VITE_FORCE_LIVE_OVERLAY: Set to "true" to force the live overlay to fetch
#                          event statuses + announcements even when the edition
#                          is not live or imminent (for testing).
VITE_FORCE_LIVE_OVERLAY=""

# VITE_TURNSTILE_SITE_KEY: Cloudflare Turnstile site key (optional).
#                          When set, the Turnstile widget appears on public forms.
#                          Leave empty to keep Turnstile disabled (default).
VITE_TURNSTILE_SITE_KEY=""

# ─── Supabase Edge Function secrets (set in the Supabase dashboard, NOT in .env) ──
# These are set as Supabase function secrets, not Vite env vars:
#   IP_SALT               — random string for hashing visitor IPs (rate limiting)
#   TURNSTILE_SECRET_KEY   — Cloudflare Turnstile secret key (optional)
#   VERCEL_DEPLOY_HOOK_URL — the Vercel deploy hook URL for the publishing pipeline
#   SITE_URL               — the public site URL (for CORS in submit-message)
# The function runtime auto-provides:
#   SUPABASE_URL            — the project URL
#   SUPABASE_ANON_KEY       — the anon key
#   SUPABASE_SERVICE_ROLE_KEY — the service role key (never in frontend code)
