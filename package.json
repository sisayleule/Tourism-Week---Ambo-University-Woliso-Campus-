{
  "name": "ambo-university-tourism-week",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "predev": "node scripts/build-content.mjs",
    "build": "vite build",
    "prebuild": "node scripts/build-content.mjs && node scripts/check-hero-media.mjs",
    "postbuild": "node scripts/seo-html.mjs && node scripts/build-health.mjs && node scripts/check-assets.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "prelint": "node scripts/build-content.mjs",
    "snapshot:save": "node scripts/build-content.mjs --save",
    "snapshot:seed": "tsx scripts/seed-snapshot.ts",
    "seed:sql": "node scripts/generate-seed-sql.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:hero": "playwright test tests/hero-layout.spec.ts --headed",
    "test:hero:ci": "playwright test tests/hero-layout.spec.ts",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:responsive:after": "node scripts/responsive-audit.mjs -- --phase after",
    "audit:overflow": "node scripts/responsive-audit.mjs -- --overflow-only",
    "audit:portal-mobile": "playwright test tests/e2e/portal-mobile.spec.ts --reporter=list",
    "audit:hero": "playwright test tests/hero-layout.spec.ts --reporter=list",
    "content:lint": "node scripts/content-lint.mjs",
    "build:health": "node scripts/build-health.mjs",
    "check:hero-media": "node scripts/check-hero-media.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "csp:generate": "node scripts/generate-vercel-json.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.49.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.3",
    "@vitejs/plugin-react": "^6.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "i18next": "^26.7.1",
    "jszip": "3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
